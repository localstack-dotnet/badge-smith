<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- slopwatch-ignore: SW005 CA1711 needed for xUnit CollectionDefinition convention (ContractCollection); MA0016 needed for the JSON-deserialized Dictionary response model mandated by the test contract -->
    <NoWarn>$(NoWarn);CA1515;CA1034;CA1707;CA1711;MA0110;MA0009;MA0016;CA1062;CA1024</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.TestUtilities" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" />
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.LocalStack" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BadgeSmith.Api\BadgeSmith.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Testing\Infrastructure\wiremock\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
