<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <NoWarn>$(NoWarn);CA1515;CA1034;CA1707;MA0110;MA0009;CA1062;CA1024</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="AWSSDK.DynamoDBv2" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BadgeSmith.Api\BadgeSmith.Api.csproj" />
    <ProjectReference Include="..\..\src\BadgeSmith.Host\BadgeSmith.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Testing\Infrastructure\wiremock\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
