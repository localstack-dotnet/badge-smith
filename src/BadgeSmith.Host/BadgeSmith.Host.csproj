<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- slopwatch-ignore: SW005 Amazon CDK assemblies are intentionally unsigned and trigger CS8002 -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AWS" />
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="LocalStack.Aspire.Hosting" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\BadgeSmith.CDK.Shared\BadgeSmith.CDK.Shared.csproj" IsAspireProjectResource="false" />

    <ProjectReference Include="..\BadgeSmith.Api\BadgeSmith.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedDir)\Constants.cs" Link="Constants.cs" />
  </ItemGroup>

</Project>
