<Project>
  <Import Project="..\Directory.Build.props" />

  <!-- The inherited GenerateDocumentationFile=true keeps IDE0005 enabled for the file-based app. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PackAsTool>false</PackAsTool>
    <PublishAot>false</PublishAot>
    <!-- File-based dotnet apps default the root namespace to the entry file name (badgesmith).
         Override so the BadgeSmith.Tools.* folder structure satisfies IDE0130. -->
    <RootNamespace>BadgeSmith.Tools</RootNamespace>
  </PropertyGroup>
</Project>
